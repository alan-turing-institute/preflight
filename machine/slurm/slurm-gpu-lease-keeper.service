# Design 3.2: one long-lived process holds the cross-project GPU lease for slurm as a whole.
# A user unit (linger is on for this account, so it runs from boot). Installed by install_slurm.py --user.
[Unit]
Description=lifecycle=service slurm's GPU lease keeper (preflight/slurm/gpu_lease_keeper.py)

[Service]
ExecStart=%h/dev/localmodels/.venv/bin/python %h/dev/turing/preflight/slurm/gpu_lease_keeper.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
