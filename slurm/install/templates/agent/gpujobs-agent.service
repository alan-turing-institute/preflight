# The job layer's agent: boot re-registration, released-job priorities, restore order, failure notices, per-job metrics.
# Rendered from the site file by slurm/install/components/agent.py; do not edit by hand.
[Unit]
Description=lifecycle=service gpujobs agent ($install_dir/slurm/agent.py)
After=slurmctld.service

[Service]
User=$slurm_user
# reads the host OOM guard's journal, to tell a job wrapper its run was killed (agent.py, OomWatch)
SupplementaryGroups=systemd-journal
Environment=GPUJOBS_SITE=$site_file
ExecStart=/usr/bin/python3 $install_dir/slurm/agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
